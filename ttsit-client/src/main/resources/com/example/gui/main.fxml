<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SpinnerValueFactory.DoubleSpinnerValueFactory?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.TextFlow?>

<!--
    Three zones, left to right: the server you talk to, the text you send and
    get back, and the voice that reads it. The grid keeps "Send" level with the
    compose box and the speech controls level with the transcript, so each
    control sits beside the thing it acts on.
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.gui.MainController"
            prefWidth="1000" prefHeight="600">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Left: server controls and the tally lamp -->
    <left>
        <VBox fx:id="serverRail" spacing="12" styleClass="server-rail">
            <BorderPane.margin>
                <Insets right="28"/>
            </BorderPane.margin>

            <Label text="SERVER" styleClass="eyebrow" accessibleText="Server"/>

            <HBox fx:id="serverStatusBox" spacing="10" alignment="CENTER_LEFT" styleClass="server-status, state-closed">
                <Circle radius="5" styleClass="tally-lamp"/>
                <Label fx:id="serverStatusLabel" text="Server closed" styleClass="status-text"/>
            </HBox>

            <Button fx:id="startServerButton" text="Start server" maxWidth="Infinity" onAction="#onStartServer"/>
            <Button fx:id="stopServerButton" text="Stop server" maxWidth="Infinity" onAction="#onStopServer"/>
        </VBox>
    </left>

    <!-- Center: compose + transcript, with their controls beside them -->
    <center>
        <GridPane hgap="20" vgap="8">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="176" prefWidth="176" hgrow="NEVER"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints/>
                <RowConstraints minHeight="160" prefHeight="200" vgrow="NEVER"/>
                <RowConstraints/>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- Row 0: eyebrow for the compose box -->
            <Label fx:id="textEyebrow" text="TEXT" styleClass="eyebrow" accessibleText="Text to speak" GridPane.rowIndex="0" GridPane.columnIndex="0"/>

            <!-- Row 1: compose box and Send -->
            <TextArea fx:id="inputTextArea" promptText="Type what should be spoken…" wrapText="true"
                      GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Button fx:id="sendButton" text="Send" maxWidth="Infinity" onAction="#onSend"
                    GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.valignment="TOP"/>

            <!-- Row 2: eyebrows for transcript and speech -->
            <HBox fx:id="transcriptHeader" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="0">
                <GridPane.margin><Insets top="12"/></GridPane.margin>
                <Label fx:id="transcriptEyebrow" text="TRANSCRIPT" styleClass="eyebrow" accessibleText="Transcript"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="clearTranscriptButton" text="Clear" styleClass="ghost" onAction="#onClearTranscript"
                        accessibleText="Clear transcript"/>
            </HBox>
            <Label fx:id="speechEyebrow" text="SPEECH" styleClass="eyebrow" accessibleText="Speech" GridPane.rowIndex="2" GridPane.columnIndex="1">
                <GridPane.margin><Insets top="12"/></GridPane.margin>
            </Label>

            <!-- Row 3: transcript and the speech controls -->
            <ScrollPane fx:id="transcriptScrollPane" fitToWidth="true" styleClass="transcript"
                        GridPane.rowIndex="3" GridPane.columnIndex="0">
                <StackPane alignment="TOP_LEFT">
                    <TextFlow fx:id="receivedTextFlow" styleClass="transcript-flow"/>
                    <Label fx:id="transcriptPlaceholder" text="Nothing received yet. Send text to see the reply here."
                           styleClass="transcript-placeholder" wrapText="true" mouseTransparent="true"/>
                </StackPane>
            </ScrollPane>

            <VBox fx:id="speechControls" spacing="12" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.valignment="TOP">
                <Button fx:id="readAloudButton" text="Read aloud" maxWidth="Infinity" styleClass="primary" onAction="#onReadAloud"/>

                <VBox spacing="4">
                    <Label text="Voice" styleClass="field-label" labelFor="$voiceComboBox"/>
                    <ComboBox fx:id="voiceComboBox" promptText="Choose a voice…" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Language" styleClass="field-label" labelFor="$languageComboBox"/>
                    <ComboBox fx:id="languageComboBox" promptText="Choose a language…" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Speed" styleClass="field-label" labelFor="$speedSpinner"/>
                    <Spinner fx:id="speedSpinner" editable="true" prefWidth="96">
                        <valueFactory>
                            <SpinnerValueFactory.DoubleSpinnerValueFactory min="0.5" max="2.0" initialValue="1.0" amountToStepBy="0.1"/>
                        </valueFactory>
                    </Spinner>
                </VBox>
            </VBox>
        </GridPane>
    </center>
</BorderPane>
